pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm ci'
            }
        }

        stage('Install Playwright Browser') {
            steps {
                bat 'npx playwright install chromium'
            }
        }

        stage('Run Google Test') {
            steps {
                bat 'npx playwright test tests/google.spec.js --project=chromium'
            }
        }

    }

  post {
    always {
        echo 'Playwright execution completed'
    }
}
}
